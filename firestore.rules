rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Subscriptions: you can read your own; only admins can write (admin.html)
    match /s/{id} {
      allow read: if request.auth != null && request.auth.uid == id;
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Admins: accounts you list by hand in the console (admins/<uid>, any fields). Clients can only check themselves.
    match /admins/{id} {
      allow read: if request.auth != null && request.auth.uid == id;
    }

    match /u/{id} {
      // Your own data doc: u/<uid>
      allow read, write: if request.auth != null && request.auth.uid == id;

      // Username claim docs: u/<name> = { u: <uid> } (the doc ID is the unique name)
      // resource == null: a free name has no doc yet, so the check must not fail on it (that was the 403 on sign-up)
      allow read: if request.auth != null && (resource == null || 'u' in resource.data);
      allow create: if request.auth != null
        && id.matches('[a-z0-9_]{3,20}')   // usernames only, so nobody can pre-create someone's uid doc
        && request.resource.data.keys().hasOnly(['u'])
        && request.resource.data.u == request.auth.uid;
      allow delete: if request.auth != null && resource.data.u == request.auth.uid;

      // Legacy tasks: u/<uid>/t/<id> — tasks now live in the q map on u/<uid> (covered by the rule above).
      // Old clients still self-migrate their subcollection; remove this block once every account has v: 2.
      match /t/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == id;
      }
    }

    // Streak leaderboard: lb/<uid>. Anyone signed in can read; you write only your own entry, and its name must be your own username claim.
    match /lb/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == id
        && request.resource.data.keys().hasOnly(['n', 't', 'b', 'd'])
        && request.resource.data.n is string && request.resource.data.t is int && request.resource.data.b is int && request.resource.data.d is string
        && request.resource.data.t >= 0 && request.resource.data.t <= 20000 && request.resource.data.b >= 0 && request.resource.data.b <= 20000
        && get(/databases/$(database)/documents/u/$(request.resource.data.n)).data.u == request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid == id;
    }

    // Workspaces: w/<ownerUid> = { m: member uids, b: balance, l: log }. Owner runs it;
    // members (m) may only change the pot balance and log — never the member list, never delete.
    match /w/{id} {
      allow read: if request.auth != null && (request.auth.uid == id || request.auth.uid in resource.data.m);
      allow create: if request.auth != null && request.auth.uid == id
        && request.resource.data.m is list && request.auth.uid in request.resource.data.m;
      allow update: if request.auth != null && request.auth.uid == id;
      allow update: if request.auth != null && request.auth.uid in resource.data.m
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['b', 'l'])
        && request.resource.data.b is int && request.resource.data.l is list && request.resource.data.l.size() <= 100;
      allow delete: if request.auth != null && request.auth.uid == id;
    }
  }
}
