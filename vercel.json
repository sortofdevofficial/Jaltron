{
  "rewrites": [
    {
      "source": "/api/:path((?!upload$|delete$).*)",
      "destination": "http://78.154.103.47:11903/api/:path"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}