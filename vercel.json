{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|html|txt|webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/legit", "destination": "/legit.html" },
    { "source": "/discord", "destination": "/index.html" },
    { "source": "/chat", "destination": "/index.html" },
    { "source": "/dc", "destination": "/index.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/tasks", "destination": "/index.html" },
    { "source": "/task", "destination": "/index.html" },
    { "source": "/focus", "destination": "/index.html" },
    { "source": "/calendar", "destination": "/index.html" },
    { "source": "/ai", "destination": "/index.html" },
    { "source": "/insights", "destination": "/index.html" },
    { "source": "/plans", "destination": "/index.html" },
    { "source": "/bank", "destination": "/index.html" },
    { "source": "/links", "destination": "/index.html" },
    { "source": "/leaderboard", "destination": "/index.html" },
    { "source": "/board", "destination": "/index.html" },
    { "source": "/reviews", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" }
  ]
}
